# HTTPS-t lezáró proxy a frontend (és rajta át az API) elé.
# A tanúsítvány és a kulcs a deploy/https/certs mappából jön (fullchain.pem, privkey.pem).

server {
    listen 80;
    server_name ${PUBLIC_HOSTNAME};
    server_tokens off;

    # Minden HTTP-kérés átirányítása HTTPS-re.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOSTNAME};
    server_tokens off;
    client_max_body_size 1m;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS: a böngésző egy évig csak HTTPS-en keresi a címet. Csak valódi (nem önaláírt)
    # tanúsítvánnyal kapcsold be véglegesen; a HSTS_MAX_AGE=0 kikapcsolja.
    add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}" always;

    location / {
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # A kliens címét felülírjuk (nem fűzzük hozzá), így a böngésző által küldött hamis
        # X-Forwarded-For nem jut tovább; a backend ForwardLimit=2 mellett ezt veszi kliens-IP-nek.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
