# Ha a frontend elé HTTPS-t lezáró proxy kerül, az általa küldött X-Forwarded-Proto értéket adjuk tovább
# a backendnek (így a bejelentkezési süti Secure lesz); közvetlen eléréskor a saját sémánkat.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 3000;
    server_name _;

    server_tokens off;
    client_max_body_size 1m;

    # Tömörítés: a JS/CSS/JSON/SVG válaszok gzippel kisebbek (a woff2 és a png már tömörített).
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    # Biztonsági fejlécek (minden válaszra; a location-blokkok add_header-je felülírná, ezért ott is szerepelnek).
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'";

    root /usr/share/nginx/html;
    index index.html;

    # API-kérések továbbítása a backendre (azonos origin, így CORS nem kell).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    }

    # A build által hashelt fájlok hosszan cache-elhetők.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        try_files $uri =404;
    }

    # Egyoldalas alkalmazás: minden más útvonal az index.html-re esik vissza.
    location / {
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        # Az index.html-t ne cache-elje a böngésző, hogy új verzió után azonnal a friss build töltődjön be.
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
