# Helyi fejlesztési helyőrző; cseréld egyedi, erős értékre a .env fájlban.
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_123!

# EULA elfogadása az MSSQL-hez
ACCEPT_EULA=Y

# JWT-hitelesítés (éles környezetben állíts be egyedi, legalább 32 bájtos kulcsot)
JWT_ISSUER=ProjektLaborAPI
JWT_AUDIENCE=ProjektLaborClient
JWT_SIGNING_KEY=ProjektLaborDevSecretKey_ChangeInProduction_MinLength32Chars!
JWT_EXPIRES_IN_HOURS=8
