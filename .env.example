# Helyi fejlesztői értékekhez készíts saját, nem commitolt .env fájlt.
# Adatbázis-jelszó (a SQL Server követelményeinek megfelelő, egyedi érték)
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_MSSQL_PASSWORD_123!

# EULA elfogadása az MSSQL-hez
ACCEPT_EULA=Y

# JWT-hitelesítés (a kulcs legalább 32 bájt legyen; például: openssl rand -base64 48)
JWT_ISSUER=projektlabor
JWT_AUDIENCE=projektlabor-api
JWT_SIGNING_KEY=REPLACE_WITH_A_RANDOM_JWT_SIGNING_KEY_AT_LEAST_32_BYTES

# Az első, üres adatbázis adminisztrátorának egyszeri inicializálása.
# Csak akkor szükségesek, ha még egyetlen felhasználó sincs az adatbázisban.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Opcionális, explicit bekapcsolású, egyszeri demófelhasználó-seedelés.
# Mindegyik jelszó legalább 12 karakter, legfeljebb 72 UTF-8 bájt legyen.
BOOTSTRAP_DEMO_USERS_ENABLED=false
DEMO_OKTATO_USERNAME=demo.oktato
DEMO_OKTATO_PASSWORD=
DEMO_PORTAS_USERNAME=demo.portas
DEMO_PORTAS_PASSWORD=
DEMO_ADMIN_USERNAME=demo.admin
DEMO_ADMIN_PASSWORD=
DEMO_IGAZGATO_USERNAME=demo.igazgato
DEMO_IGAZGATO_PASSWORD=

# Konténerben alapértelmezés szerint éles környezet.
ASPNETCORE_ENVIRONMENT=Production
