# Helyi fejlesztői értékekhez készíts saját, nem commitolt .env fájlt.
# Adatbázis-jelszó (a SQL Server követelményeinek megfelelő, egyedi érték)
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_MSSQL_PASSWORD_123!

# Az alkalmazás saját adatbázis-felhasználójának (projektlabor_app) jelszava. A backend ezzel csatlakozik,
# nem az "sa" fiókkal. Legalább 12 karakter, idézőjel nélkül; a SQL Server jelszószabályainak megfelelő.
MSSQL_APP_PASSWORD=REPLACE_WITH_STRONG_APP_DB_PASSWORD_123!

# EULA elfogadása az MSSQL-hez
ACCEPT_EULA=Y

# JWT-hitelesítés (a kulcs legalább 32 bájt legyen; például: openssl rand -base64 48)
JWT_ISSUER=projektlabor
JWT_AUDIENCE=projektlabor-api
JWT_SIGNING_KEY=REPLACE_WITH_A_RANDOM_JWT_SIGNING_KEY_AT_LEAST_32_BYTES

# Az első, üres adatbázis adminisztrátorának egyszeri inicializálása.
# Üres adatbázisnál a Compose-indításhoz kötelezőek; cseréld saját értékekre.
BOOTSTRAP_ADMIN_USERNAME=REPLACE_WITH_BOOTSTRAP_ADMIN
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_BOOTSTRAP_PASSWORD_12+

# A migrációk által létrehozott mintafiókok (admin, oktato, portas, igazgato, radli.richard) jelszava
# a repóban nyilvános. Alapértelmezés szerint induláskor letiltjuk azokat, amelyek jelszava még az
# eredeti; csak bemutatóhoz/fejlesztéshez állítsd true-ra, éles üzemben SOHA.
SAMPLE_ACCOUNTS_ENABLED=false

# Ha az alkalmazás elé HTTPS-t lezáró proxy kerül (éles üzemben ajánlott), állítsd true-ra:
# a bejelentkezési süti ekkor csak HTTPS-en utazik.
AUTH_COOKIE_SECURE=false

# A böngészőből közvetlenül (proxy nélkül) elérhető frontend originök, vesszővel elválasztva.
# A Docker Compose-os futtatásnál a frontend proxyn keresztül éri el az API-t, így ez üres maradhat.
CORS_ALLOWED_ORIGINS=

# Konténerben alapértelmezés szerint éles környezet.
ASPNETCORE_ENVIRONMENT=Production
