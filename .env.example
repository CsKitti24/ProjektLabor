# Helyi fejlesztői értékekhez készíts saját, nem commitolt .env fájlt.
# Adatbázis-jelszó (a SQL Server követelményeinek megfelelő, egyedi érték)
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_MSSQL_PASSWORD_123!

# EULA elfogadása az MSSQL-hez
ACCEPT_EULA=Y

# JWT-hitelesítés (a kulcs legalább 32 bájt legyen; például: openssl rand -base64 48)
JWT_ISSUER=projektlabor
JWT_AUDIENCE=projektlabor-api
JWT_SIGNING_KEY=REPLACE_WITH_A_RANDOM_JWT_SIGNING_KEY_AT_LEAST_32_BYTES

# Az első, üres adatbázis adminisztrátorának egyszeri inicializálása.
# Üres adatbázisnál a Compose-indításhoz kötelezőek; cseréld saját értékekre.
BOOTSTRAP_ADMIN_USERNAME=REPLACE_WITH_BOOTSTRAP_ADMIN
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_BOOTSTRAP_PASSWORD_12+

# Helyi prezentációs demófelhasználók (csak fejlesztéshez)
DEMO_OKTATO_PASSWORD=DemoOktato2026!
DEMO_PORTAS_PASSWORD=DemoPortas2026!
DEMO_ADMIN_PASSWORD=DemoAdmin2026!
DEMO_IGAZGATO_PASSWORD=DemoIgazgato2026!

# Konténerben alapértelmezés szerint éles környezet.
ASPNETCORE_ENVIRONMENT=Production
